# GP-API Credentials (from developer.globalpayments.com)
GP_APP_ID=your_app_id_here
GP_APP_KEY=your_app_key_here
GP_API_ENVIRONMENT=sandbox

# Optional partner-mode merchant routing. Leave blank for standard app credentials.
GP_PARTNER_MERCHANT_ID=

# Account ID — TRA_ prefixed value for your channel (e.g. transaction_processing)
GP_ACCOUNT_ID=TRA_your_account_id_here

# Account name — must match portal EXACTLY (case-sensitive)
GP_ACCOUNT_NAME=transaction_processing
GP_TOKENIZATION_ACCOUNT_NAME=

# 3DS notification URLs. CHALLENGE_NOTIFICATION_URL must be HTTPS for auth tests.
# For browser testing, publish this backend behind HTTPS and point both URLs at
# /3ds-method-notification and /3ds-challenge-notification.
METHOD_NOTIFICATION_URL=
CHALLENGE_NOTIFICATION_URL=
FRONTEND_ORIGIN=http://localhost:8000

# Backend port
PORT=3001
